+                for layer in self.peers:
+                    errs = ', '.join(f"{k}: {r / self.iteration_threshold:.4f}/{st / self.iteration_threshold:.4f}" for k, (r, st) in layer.calib_err.items())
+                    src = 'plan' if layer.plan_rebuild is not None else f'tau={layer.rebuild_tau}'
+                    print(f"[adahyc] layer {layer.layer_idx}: rebuild={sorted(layer.rebuild)} ({src}) bits={layer.bits} rel-err rebuild/store: {errs}")
